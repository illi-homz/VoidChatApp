# Telegram notification (посмотреть в GitHub Secrets)
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather
# TELEGRAM_CHAT_ID — ID группы (с минусом, например -1002456871234)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Android release signing (пароли от keystore)
# ANDROID_KEY_ALIAS обычно "upload"
# Пароли — в менеджере паролей (1Password / Bitwarden)
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_ALIAS=upload
