<?xml version="1.0" encoding="utf-8"?>
<!--
  VoidChat – Piracy‑style adaptive icon foreground
  Skull & crossbones on transparent background.
  Viewport is the standard 108×108 Android adaptive icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ══════════════════════════════════════════════════
         CROSSBONES (drawn first so they sit behind skull)
         Two elongated rounded rectangles rotated ±35°
         around the icon centre (54, 54).
         ══════════════════════════════════════════════════ -->

    <!-- Bone 1 – rotated −35° (top‑left → bottom‑right) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-35">
        <path
            android:pathData="M8,48L100,48Q104,48 104,52L104,60Q104,64 100,64L8,64Q4,64 4,60L4,52Q4,48 8,48Z"
            android:fillColor="#F0F0F0"
            android:fillAlpha="0.95"/>
    </group>

    <!-- Bone 2 – rotated +35° (bottom‑left → top‑right) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="35">
        <path
            android:pathData="M8,48L100,48Q104,48 104,52L104,60Q104,64 100,64L8,64Q4,64 4,60L4,52Q4,48 8,48Z"
            android:fillColor="#F0F0F0"
            android:fillAlpha="0.95"/>
    </group>

    <!-- ══════════════════════════════════════════════════
         SKULL – outer silhouette
         Smooth rounded cranium, slightly flared cheekbones
         and a narrower rounded jaw.
         ══════════════════════════════════════════════════ -->
    <path
        android:pathData="M54,16
            C66,16 78,24 78,38
            C78,47 75,56 71,60
            C68,64 64,68 59,71
            Q54,73 49,71
            C44,68 41,64 37,60
            C33,56 30,47 30,38
            C30,24 42,16 54,16
            Z"
        android:fillColor="#F0F0F0"/>

    <!-- ══════════════════════════════════════════════════
         EYE SOCKETS – two circular voids
         ══════════════════════════════════════════════════ -->

    <!-- Left eye socket  (centre ~41, 39) -->
    <path
        android:pathData="M41,33.5A5.5,5.5 0 1,1 41,44.5A5.5,5.5 0 1,1 41,33.5Z"
        android:fillColor="#080808"/>

    <!-- Right eye socket (centre ~67, 39) -->
    <path
        android:pathData="M67,33.5A5.5,5.5 0 1,1 67,44.5A5.5,5.5 0 1,1 67,33.5Z"
        android:fillColor="#080808"/>

    <!-- ══════════════════════════════════════════════════
         NOSE – inverted triangle (pirate‑skull style)
         ══════════════════════════════════════════════════ -->
    <path
        android:pathData="M54,45L50,54L58,54Z"
        android:fillColor="#080808"/>

    <!-- ══════════════════════════════════════════════════
         MOUTH – dark base with individual white teeth
         Base is a black rectangle; teeth are white rects
         drawn on top with 1 dp gaps between them.
         ══════════════════════════════════════════════════ -->

    <!-- Mouth / gum background -->
    <path
        android:pathData="M36,58L72,58L72,66L36,66Z"
        android:fillColor="#080808"/>

    <!-- Seven rectangular teeth (#F0F0F0) -->
    <path android:pathData="M37,59h4v6h-4Z" android:fillColor="#F0F0F0"/>
    <path android:pathData="M42,59h4v6h-4Z" android:fillColor="#F0F0F0"/>
    <path android:pathData="M47,59h4v6h-4Z" android:fillColor="#F0F0F0"/>
    <path android:pathData="M52,59h4v6h-4Z" android:fillColor="#F0F0F0"/>
    <path android:pathData="M57,59h4v6h-4Z" android:fillColor="#F0F0F0"/>
    <path android:pathData="M62,59h4v6h-4Z" android:fillColor="#F0F0F0"/>
    <path android:pathData="M67,59h4v6h-4Z" android:fillColor="#F0F0F0"/>

</vector>
